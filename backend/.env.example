# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Bishkek
DJANGO_LOG_LEVEL=INFO

# Database (used by Django settings)
DATABASE_URL=postgres://sushi:sushi@db:5432/sushi
# Used only by entrypoint wait-for-db
DB_HOST=db
DB_PORT=5432

# CORS / CSRF (frontend origin)
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# DRF throttling
DRF_ANON_THROTTLE=120/min
DRF_ORDERS_THROTTLE=20/min

# Security (prod)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=2592000

# Initial superuser (optional, created on first boot)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me

# Seed demo catalog on boot
DJANGO_SEED_DEMO=true

# Telegram notifications for new orders (create a bot via @BotFather,
# get the chat id by adding the bot to a chat and calling getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
