# ----------------------------------------------------------------------------
# Root compose environment. Copy to `.env` and also create `backend/.env`
# (from backend/.env.example). Values below assume the full Docker stack
# served behind Nginx on port 80.
# ----------------------------------------------------------------------------

# PostgreSQL
POSTGRES_DB=sushi
POSTGRES_USER=sushi
POSTGRES_PASSWORD=change-me-strong-password

# Public URLs (browser-facing). With Nginx everything is same-origin on :80.
NEXT_PUBLIC_API_URL=http://localhost
NEXT_PUBLIC_SITE_URL=http://localhost

# -----------------------------------------------------------------------------
# Production menu site (Cloudflare Worker `teyva-menu` → https://menu.teyva.us)
# Set these when building the static export (see frontend/.env.example):
#   NEXT_PUBLIC_API_URL=https://<YOUR_PUBLIC_API_HOST>
#   NEXT_PUBLIC_SITE_URL=https://menu.teyva.us
# -----------------------------------------------------------------------------

