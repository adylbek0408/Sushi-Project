# Public API base URL (browser + static build-time fetches). No trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Path prefix before endpoints. Empty for Teyva prod (api.teyva.us).
# Local Django Sushiya: NEXT_PUBLIC_API_PREFIX=/api/v1
NEXT_PUBLIC_API_PREFIX=

# Internal API URL used by Next.js SSR in Docker only (ignored on CF static).
INTERNAL_API_URL=http://api:8000

# Canonical site URL for SEO (sitemap / metadata / Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Storefront defaults (Teyva public API has no /settings).
NEXT_PUBLIC_SHOP_NAME=Teyva
NEXT_PUBLIC_WHATSAPP_NUMBER=996555119981

# -----------------------------------------------------------------------------
# Production — https://menu.teyva.us (Cloudflare Worker: teyva-menu)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL=https://api.teyva.us
# NEXT_PUBLIC_API_PREFIX=
# NEXT_PUBLIC_SITE_URL=https://menu.teyva.us
# NEXT_PUBLIC_SHOP_NAME=Teyva
# NEXT_PUBLIC_WHATSAPP_NUMBER=<prod WhatsApp digits only>
#
# CORS: api must allow Origin https://menu.teyva.us
# Build: npm run prepare:cf  →  repo-root public/  →  npx wrangler deploy
