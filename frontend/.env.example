# Public API base URL (browser + server). Reachable from the user's browser.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Internal API URL used by Next.js server-side fetches (SSR/ISR).
# In Docker this points to the backend service name.
INTERNAL_API_URL=http://api:8000

# Canonical site URL for SEO (sitemap / metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
